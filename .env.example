NODE_ENV=dev
HOST=127.0.0.1
PORT=3001

# Configure a random value of at least 32 bytes; never use this placeholder.
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

MYSQL_HOST=127.0.0.1
MYSQL_SSL=false
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=KindMetrics_Erick

# Required only for Company database connections.
DB_COMPANY_HOST=127.0.0.1
DB_COMPANY_PORT=3306
DB_COMPANY_DATABASE=COCA
DB_COMPANY_SSL=false
DB_COMPANY_CONNECTION_LIMIT=10
DB_COMPANY_IDLE_TIMEOUT_MS=60000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=tu-cuenta@gmail.com
MAIL_PASS=REEMPLAZA_CON_CONTRASENA_DE_APLICACION
# Public KindMetrics frontend origin; use the deployed HTTPS URL in QA/production.
APP_BASE_URL=http://localhost:9000
# Optional; use MAIL_USER as the sender account unless Gmail is configured with an alias.
# MAIL_FROM="KindMetrics <tu-cuenta@gmail.com>"
# Set to a persistent Base64-encoded 32-byte key; never use this placeholder.
COMPANY_DB_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

CORS_ORIGIN=http://localhost:9000,http://localhost:9001
