NODE_ENV=dev
HOST=127.0.0.1
PORT=3001

# Configure a random value of at least 32 bytes; never use this placeholder.
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=kindmetrics

# Required only for Company database connections.
DB_COMPANY_HOST=127.0.0.1
DB_COMPANY_PORT=3306
DB_COMPANY_SSL=false
DB_COMPANY_CONNECTION_LIMIT=10
DB_COMPANY_IDLE_TIMEOUT_MS=60000
# Set to a persistent Base64-encoded 32-byte key; never use this placeholder.
COMPANY_DB_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

CORS_ORIGIN=http://localhost:9000,http://localhost:9001
